{
  "name": "perfume101-motion-comic",
  "version": "1.0.0",
  "private": true,
  "description": "EXPERIMENTAL PERFUMERY - PERFUME 101 60s motion comic (Remotion)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Perfume101 out/Perfume101_final.mp4 --codec h264 --crf 16 --audio-codec aac --audio-bitrate 320k",
    "render:preview": "remotion render src/index.ts Perfume101 out/Perfume101_preview.mp4 --scale 0.5 --crf 26",
    "still": "remotion still src/index.ts Perfume101 out/still.png",
    "assets": "python3 tools/build_mrx_rig.py && python3 tools/build_xbot_rig.py",
    "audio": "python3 tools/compose_music.py public/audio/music/perfume101_score.wav && python3 tools/synth_sfx.py public/audio/sfx"
  },
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "@remotion/fonts": "4.0.545",
    "@remotion/google-fonts": "4.0.545",
    "@remotion/noise": "4.0.545",
    "@remotion/paths": "4.0.545",
    "@remotion/shapes": "4.0.545",
    "@remotion/transitions": "4.0.545",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.545"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.6.3"
  }
}
